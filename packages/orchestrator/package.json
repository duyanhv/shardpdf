{
  "name": "@shardpdf/orchestrator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "soak": "SOAK=1 node --test \"test/soak.test.ts\""
  },
  "dependencies": {
    "@shardpdf/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/pdfkit": "^0.17.6",
    "pdfkit": "^0.19.1"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./adapter": {
      "types": "./src/adapter.ts",
      "import": "./src/adapter.ts"
    },
    "./types": {
      "types": "./src/types.ts",
      "import": "./src/types.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ]
}
