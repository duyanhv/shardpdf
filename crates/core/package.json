{
  "name": "@shardpdf/core",
  "version": "0.1.0",
  "private": true,
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "shardpdf-core",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform",
    "build:release": "napi build --platform --release",
    "fuzz": "rustup run nightly cargo fuzz run append_shard --fuzz-dir fuzz",
    "fuzz:seed": "cargo run --example gen_fuzz_seed",
    "test": "cargo test -p shardpdf-core"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  }
}
