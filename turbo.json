{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.node"]
    },
    "typecheck": {},
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": false
    },
    "bench": {
      "cache": false
    }
  }
}
